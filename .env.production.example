# Copy to .env.production on the server and fill in every CHANGE_ME value.
# Generate secrets with:  openssl rand -base64 32

APP_NAME=PhytoQuest
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME_run_php_artisan_key_generate_show
APP_URL=https://phytoquest.duckdns.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Caddy: your domain (automatic HTTPS) and an email for Let's Encrypt notices.
SERVER_NAME=phytoquest.duckdns.org
ACME_EMAIL=you@example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=phytoquest
DB_USERNAME=phytoquest
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Mail is logged until you add an SMTP provider (needed for password-reset emails).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@phytoquest.duckdns.org
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: the app talks to the reverb container; browsers connect through Caddy on 443.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_any_number
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_CLIENT_HOST=phytoquest.duckdns.org
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https

# ML service: a Hugging Face Space (https://<user>-phytoquest-ml.hf.space) or, with
# COMPOSE_PROFILES=ml, the local container (http://ml:8001). Same token on both sides.
ML_SERVICE_URL=https://CHANGE_ME-phytoquest-ml.hf.space
ML_SERVICE_TOKEN=CHANGE_ME
ML_SERVICE_TIMEOUT=60
ML_LOW_CONFIDENCE_THRESHOLD=0.35
ML_TAXA_PATH=/app/storage/app/private/taxa.json
PFAF_EXPORT_PATH=/app/storage/app/private/imports/pfaf_plants_merged.csv
# COMPOSE_PROFILES=ml
